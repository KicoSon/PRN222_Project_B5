@model StudentPartTime.Models.ApplicationStatisticsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thống kê đơn ứng tuyển";
    ViewData["ActiveTab"] = "ApplicationStatistics";
}

<div class="spt-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-send me-2"></i>Thống kê đơn ứng tuyển</h2>
    <div class="spt-card px-3 py-2">
        <span class="text-muted small">Tổng số đơn:</span>
        <span class="fw-bold fs-5 ms-1" id="stat-total-applications">@Model.TotalApplications</span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="spt-card p-4 h-100">
            <h6 class="fw-bold mb-3">Đơn theo trạng thái</h6>
            <canvas id="chartByStatus" height="240"></canvas>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="spt-card p-4 h-100">
            <h6 class="fw-bold mb-3">Đơn theo tháng (12 tháng gần nhất)</h6>
            <canvas id="chartByMonth" height="240"></canvas>
        </div>
    </div>
</div>

<div class="spt-card p-4">
    <h6 class="fw-bold mb-3">Bảng số liệu chi tiết</h6>
    <div class="row">
        <div class="col-md-6">
            <table class="table table-sm table-borderless">
                <thead><tr><th>Trạng thái</th><th class="text-end">Số lượng</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.ByStatus)
                    {
                        <tr><td>@item.Label</td><td class="text-end fw-semibold">@item.Value</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <table class="table table-sm table-borderless">
                <thead><tr><th>Tháng</th><th class="text-end">Số lượng</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.ByMonth)
                    {
                        <tr><td>@item.MonthLabel</td><td class="text-end fw-semibold">@item.Count</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chartColors = ['#0a66c2', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#20c997', '#fd7e14', '#6c757d'];

        new Chart(document.getElementById('chartByStatus'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ByStatus.Select(x => x.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.ByStatus.Select(x => x.Value))),
                    backgroundColor: chartColors
                }]
            },
            options: { responsive: true }
        });

        new Chart(document.getElementById('chartByMonth'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ByMonth.Select(x => x.MonthLabel))),
                datasets: [{
                    label: 'Số đơn ứng tuyển',
                    data: @Html.Raw(Json.Serialize(Model.ByMonth.Select(x => x.Count))),
                    borderColor: '#0a66c2',
                    backgroundColor: 'rgba(10,102,194,0.15)',
                    tension: 0.3,
                    fill: true
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });
    </script>
}
