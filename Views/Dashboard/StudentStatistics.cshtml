@model StudentPartTime.Models.StudentStatisticsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thống kê sinh viên";
    ViewData["ActiveTab"] = "StudentStatistics";
}

<div class="spt-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-mortarboard me-2"></i>Thống kê sinh viên</h2>
    <div class="spt-card px-3 py-2">
        <span class="text-muted small">Tổng số sinh viên:</span>
        <span class="fw-bold fs-5 ms-1" id="stat-total-students">@Model.TotalStudents</span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="spt-card p-4 h-100">
            <h6 class="fw-bold mb-3">Sinh viên theo chuyên ngành</h6>
            <canvas id="chartByMajor" height="260"></canvas>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="spt-card p-4 h-100">
            <h6 class="fw-bold mb-3">Sinh viên theo trường</h6>
            <table class="table table-sm table-borderless">
                <thead><tr><th>Trường</th><th class="text-end">Số lượng</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.ByUniversity)
                    {
                        <tr><td>@item.Label</td><td class="text-end fw-semibold">@item.Value</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="spt-card p-4">
    <h6 class="fw-bold mb-3">Top danh mục được ứng tuyển nhiều nhất</h6>
    <table class="table table-sm table-borderless">
        <thead><tr><th>Danh mục</th><th class="text-end">Số lượt ứng tuyển</th></tr></thead>
        <tbody>
            @foreach (var item in Model.TopAppliedCategories)
            {
                <tr><td>@item.Label</td><td class="text-end fw-semibold">@item.Value</td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const chartColors = ['#0a66c2', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#20c997', '#fd7e14', '#6c757d'];

        new Chart(document.getElementById('chartByMajor'), {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ByMajor.Select(x => x.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.ByMajor.Select(x => x.Value))),
                    backgroundColor: chartColors
                }]
            },
            options: { responsive: true }
        });
    </script>
}
