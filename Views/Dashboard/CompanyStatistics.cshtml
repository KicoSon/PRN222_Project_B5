@model StudentPartTime.Models.CompanyStatisticsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thống kê công ty";
    ViewData["ActiveTab"] = "CompanyStatistics";
}

<div class="spt-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-building me-2"></i>Thống kê công ty</h2>
    <div class="spt-card px-3 py-2">
        <span class="text-muted small">Tổng số công ty:</span>
        <span class="fw-bold fs-5 ms-1" id="stat-total-companies">@Model.TotalCompanies</span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="spt-card p-4 h-100">
            <h6 class="fw-bold mb-3">Top công ty theo số lượng tin đăng</h6>
            <canvas id="chartTopCompanies" height="260"></canvas>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="spt-card p-4 h-100">
            <h6 class="fw-bold mb-3">Công ty theo trạng thái</h6>
            <table class="table table-sm table-borderless">
                <thead><tr><th>Trạng thái</th><th class="text-end">Số lượng</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.ByStatus)
                    {
                        <tr><td>@item.Label</td><td class="text-end fw-semibold">@item.Value</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="spt-card p-4">
    <h6 class="fw-bold mb-3">Bảng chi tiết Top công ty</h6>
    <table class="table table-sm table-borderless">
        <thead><tr><th>Công ty</th><th class="text-end">Số tin đăng</th></tr></thead>
        <tbody>
            @foreach (var item in Model.TopCompanies)
            {
                <tr><td>@item.CompanyName</td><td class="text-end fw-semibold">@item.JobCount</td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('chartTopCompanies'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.TopCompanies.Select(x => x.CompanyName))),
                datasets: [{
                    label: 'Số tin đăng',
                    data: @Html.Raw(Json.Serialize(Model.TopCompanies.Select(x => x.JobCount))),
                    backgroundColor: '#0a66c2'
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });
    </script>
}
