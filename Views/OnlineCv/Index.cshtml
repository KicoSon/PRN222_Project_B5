@model IEnumerable<StudentPartTime.Models.Resume>
@{
    ViewData["Title"] = "CV trực tuyến của tôi";
}

<div class="container mt-2">
    <div class="spt-page-header mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h4 fw-bold text-dark mb-1"><i class="bi bi-file-earmark-person-fill text-linkedin me-2"></i>CV trực tuyến của tôi</h1>
                <p class="text-muted small mb-0">Tạo CV online để được gợi ý việc làm phù hợp với kỹ năng của bạn, và nộp đơn chỉ với một cú nhấp chuột.</p>
            </div>
            <a asp-action="Create" class="btn btn-linkedin"><i class="bi bi-plus-lg me-1"></i>Tạo CV mới</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="spt-card text-center py-5">
            <i class="bi bi-file-earmark-plus display-4 text-muted mb-3"></i>
            <h5 class="fw-bold text-dark">Bạn chưa có CV trực tuyến nào</h5>
            <p class="text-muted small mb-3">Tạo CV online để hệ thống gợi ý việc làm phù hợp với kỹ năng của bạn.</p>
            <a asp-action="Create" class="btn btn-linkedin btn-sm">Tạo CV trực tuyến</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var cv in Model)
            {
                <div class="col-md-6">
                    <div class="spt-card p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-linkedin bg-opacity-10 text-linkedin p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-file-earmark-text-fill fs-3"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark line-clamp-1">@cv.DesiredTitle</div>
                            <div class="small text-muted mb-1">
                                Cập nhật: @cv.UploadedAt.ToString("dd/MM/yyyy")
                            </div>
                            @if (cv.IsDefault)
                            {
                                <span class="badge-linkedin-success"><i class="bi bi-star-fill me-1"></i>CV Mặc định</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <a asp-action="Preview" asp-route-id="@cv.ResumeId" class="btn btn-sm btn-light border rounded-circle" title="Xem CV">
                                <i class="bi bi-eye text-dark"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@cv.ResumeId" class="btn btn-sm btn-light border rounded-circle" title="Chỉnh sửa">
                                <i class="bi bi-pencil text-dark"></i>
                            </a>
                            @if (!cv.IsDefault)
                            {
                                <form asp-action="MakeDefault" asp-route-id="@cv.ResumeId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border rounded-circle" title="Đặt làm CV mặc định">
                                        <i class="bi bi-star text-warning"></i>
                                    </button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@cv.ResumeId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border rounded-circle" title="Xóa CV" onclick="return confirm('Xóa CV trực tuyến này?')">
                                    <i class="bi bi-trash text-danger"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>