@model StudentPartTime.Models.Job
@{
    ViewData["Title"] = "Đăng tin tuyển dụng";
}

<div class="container mt-2">
    <div class="spt-page-header mb-3">
        <h1 class="h4 fw-bold text-dark mb-1"><i class="bi bi-plus-square-fill text-linkedin me-2"></i>Đăng tin tuyển dụng mới</h1>
        <p class="text-muted small mb-0">Nhập đầy đủ thông tin để thu hút các ứng viên sinh viên phù hợp nhất.</p>
    </div>

    <div class="spt-form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Title">Tiêu đề vị trí tuyển dụng *</label>
                    <input asp-for="Title" class="form-control" placeholder="VD: Nhân viên phục vụ bán thời gian / Content Writer" id="input-job-title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CategoryId">Danh mục công việc *</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" id="select-category">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="JobTypeId">Hình thức công việc *</label>
                    <select asp-for="JobTypeId" asp-items="ViewBag.JobTypes" class="form-select" id="select-job-type">
                        <option value="">-- Chọn hình thức --</option>
                    </select>
                    <span asp-validation-for="JobTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ProvinceId">Tỉnh / Thành phố *</label>
                    <select asp-for="ProvinceId" asp-items="ViewBag.Provinces" class="form-select" id="select-province">
                        <option value="">-- Chọn địa điểm --</option>
                    </select>
                    <span asp-validation-for="ProvinceId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SalaryMin">Lương tối thiểu (triệu VNĐ)</label>
                    <input asp-for="SalaryMin" class="form-control" type="number" step="0.5" min="0" placeholder="VD: 3" id="input-salary-min" />
                    <span asp-validation-for="SalaryMin" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SalaryMax">Lương tối đa (triệu VNĐ)</label>
                    <input asp-for="SalaryMax" class="form-control" type="number" step="0.5" min="0" placeholder="VD: 6" id="input-salary-max" />
                    <span asp-validation-for="SalaryMax" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Quantity">Số lượng cần tuyển *</label>
                    <input asp-for="Quantity" class="form-control" type="number" min="1" value="1" id="input-quantity" />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="WorkingTime">Thời gian làm việc</label>
                    <input asp-for="WorkingTime" class="form-control" placeholder="VD: Ca sáng 8h-12h / Ca tối 18h-22h" id="input-working-time" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Deadline">Hạn nộp hồ sơ *</label>
                    <input asp-for="Deadline" class="form-control" type="date" id="input-deadline" />
                    <span asp-validation-for="Deadline" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Address">Địa chỉ làm việc cụ thể</label>
                    <input asp-for="Address" class="form-control" placeholder="VD: 123 Nguyễn Văn Cừ, Quận 5, TP.HCM" id="input-job-address" />
                </div>
                <div class="col-12">
                    <label asp-for="Description">Mô tả công việc chi tiết *</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Mô tả nhiệm vụ hàng ngày..." id="input-description"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Requirement">Yêu cầu đối với ứng viên</label>
                    <textarea asp-for="Requirement" class="form-control" rows="3" placeholder="Kỹ năng, độ tuổi, yêu cầu bằng cấp..." id="input-requirement"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Benefit">Quyền lợi và chế độ đãi ngộ</label>
                    <textarea asp-for="Benefit" class="form-control" rows="3" placeholder="Thưởng, phụ cấp, đào tạo..." id="input-benefit"></textarea>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                <a asp-action="MyJobs" class="btn btn-outline-secondary" id="btn-cancel-job">Hủy</a>
                <button type="submit" class="btn btn-linkedin px-4" id="btn-submit-job"><i class="bi bi-send me-1"></i>Đăng tin ngay</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
