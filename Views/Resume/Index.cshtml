@model IEnumerable<StudentPartTime.Models.Resume>
@{
    ViewData["Title"] = "CV của tôi";
}

<div class="container mt-2">
    <div class="spt-page-header mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h4 fw-bold text-dark mb-1"><i class="bi bi-file-earmark-person-fill text-linkedin me-2"></i>Quản lý CV ứng tuyển</h1>
                <p class="text-muted small mb-0">Tải lên và chọn CV mặc định để nộp đơn tuyển dụng nhanh chóng.</p>
            </div>
            <button type="button" class="btn btn-linkedin" data-bs-toggle="modal" data-bs-target="#uploadModal" id="btn-upload-cv">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i>Tải lên CV mới
            </button>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="spt-card text-center py-5">
            <i class="bi bi-file-earmark-plus display-4 text-muted mb-3"></i>
            <h5 class="fw-bold text-dark">Bạn chưa tải lên CV nào</h5>
            <p class="text-muted small mb-3">Hãy tải lên bản CV tốt nhất (PDF/Word) để bắt đầu nộp đơn vào các vị trí mong muốn.</p>
            <button type="button" class="btn btn-linkedin btn-sm" data-bs-toggle="modal" data-bs-target="#uploadModal">Tải lên ngay</button>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var resume in Model)
            {
                <div class="col-md-6">
                    <div class="spt-card p-3 d-flex align-items-center gap-3">
                        <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-file-earmark-pdf-fill fs-3"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark line-clamp-1">@resume.FileName</div>
                            <div class="small text-muted mb-1">
                                @((resume.FileSize ?? 0) / 1024) KB <span class="mx-1">•</span> Tải lên: @resume.UploadedAt.ToString("dd/MM/yyyy")
                            </div>
                            @if (resume.IsDefault)
                            {
                                <span class="badge-linkedin-success"><i class="bi bi-star-fill me-1"></i>CV Mặc định</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <a href="@resume.FilePath" target="_blank" class="btn btn-sm btn-light border rounded-circle" id="btn-view-resume-@resume.ResumeId" title="Xem file CV">
                                <i class="bi bi-eye text-dark"></i>
                            </a>
                            @if (!resume.IsDefault)
                            {
                                <form asp-action="SetDefault" asp-route-id="@resume.ResumeId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border rounded-circle" id="btn-set-default-@resume.ResumeId" title="Đặt làm CV mặc định">
                                        <i class="bi bi-star text-warning"></i>
                                    </button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@resume.ResumeId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border rounded-circle" id="btn-delete-resume-@resume.ResumeId" title="Xóa CV" onclick="return confirm('Xóa CV này?')">
                                    <i class="bi bi-trash text-danger"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-upload text-linkedin me-2"></i>Tải lên CV mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Chọn tệp tài liệu CV</label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.doc,.docx" required id="input-cv-file" />
                        <div class="form-text mt-2">Hỗ trợ định dạng: PDF, DOC, DOCX. Dung lượng tối đa: 5MB.</div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-linkedin" id="btn-confirm-upload"><i class="bi bi-cloud-arrow-up me-1"></i>Tải lên ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>
