<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .admin-sidebar {
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.08);
            min-height: calc(100vh - 57px - 57px);
        }

            .admin-sidebar .nav-link {
                color: rgba(0, 0, 0, 0.7);
                font-weight: 500;
                border-radius: 6px;
                padding: 0.75rem 1rem;
                margin-bottom: 0.25rem;
                transition: all 0.15s ease;
            }

                .admin-sidebar .nav-link:hover {
                    background-color: #f3f2ef;
                    color: #000000;
                }

                .admin-sidebar .nav-link.active {
                    background-color: rgba(10, 102, 194, 0.1);
                    color: #0a66c2 !important;
                    font-weight: 600;
                }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light-gray">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-lock-fill me-2 fs-3 text-linkedin"></i>
                    <span class="logo-text">StudentPT <span class="badge bg-dark text-white ms-1 rounded-1 fs-6">Admin</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAdmin"
                        aria-controls="navbarAdmin" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarAdmin">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-globe me-1"></i>Xem trang chủ
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 border px-3 py-1 rounded-pill" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5 text-linkedin"></i>
                                <span class="fw-semibold">@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border shadow-sm mt-2">
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2 w-100 text-start border-0 bg-transparent">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0 flex-grow-1">
        <div class="row g-0 min-vh-100-minus-nav">
            <!-- Sidebar column -->
            <div class="col-md-3 col-lg-2 admin-sidebar p-3 d-none d-md-block">
                <div class="sticky-top" style="top: 20px;">
                    <h6 class="text-uppercase text-muted fw-bold px-3 mb-3 small">Hệ thống</h6>
                    <nav class="nav flex-column">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Trang chủ Admin
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                            <i class="bi bi-people"></i> Quản lý người dùng
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "Categories" ? "active" : "")" asp-controller="Admin" asp-action="Categories">
                            <i class="bi bi-tags"></i> Quản lý danh mục
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "JobTypes" ? "active" : "")" asp-controller="Admin" asp-action="JobTypes">
                            <i class="bi bi-briefcase"></i> Quản lý loại công việc
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "Provinces" ? "active" : "")" asp-controller="Admin" asp-action="Provinces">
                            <i class="bi bi-geo-alt"></i> Quản lý tỉnh/thành
                        </a>
                    </nav>

                    <h6 class="text-uppercase text-muted fw-bold px-3 mb-3 mt-4 small">Quản trị hệ thống</h6>
                    <nav class="nav flex-column">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "Companies" ? "active" : "")" asp-controller="Company" asp-action="Index">
                            <i class="bi bi-building"></i> Quản lý công ty
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "Moderation" ? "active" : "")" asp-controller="Job" asp-action="PendingJobs">
                            <i class="bi bi-hourglass-split"></i> Duyệt tin tuyển dụng
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "Notifications" ? "active" : "")" asp-controller="Admin" asp-action="Notifications">
                            <i class="bi bi-bell"></i> Thông báo hệ thống
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "AuditLogs" ? "active" : "")" asp-controller="Admin" asp-action="AuditLogs">
                            <i class="bi bi-journal-text"></i> Nhật ký hệ thống
                        </a>
                    </nav>

                    <h6 class="text-uppercase text-muted fw-bold px-3 mb-3 mt-4 small">Thống kê</h6>
                    <nav class="nav flex-column">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "JobStatistics" ? "active" : "")" asp-controller="Dashboard" asp-action="JobStatistics">
                            <i class="bi bi-bar-chart"></i> Thống kê tin tuyển dụng
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "ApplicationStatistics" ? "active" : "")" asp-controller="Dashboard" asp-action="ApplicationStatistics">
                            <i class="bi bi-send"></i> Thống kê đơn ứng tuyển
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "CompanyStatistics" ? "active" : "")" asp-controller="Dashboard" asp-action="CompanyStatistics">
                            <i class="bi bi-building"></i> Thống kê công ty
                        </a>
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewData["ActiveTab"]?.ToString() == "StudentStatistics" ? "active" : "")" asp-controller="Dashboard" asp-action="StudentStatistics">
                            <i class="bi bi-mortarboard"></i> Thống kê sinh viên
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Content column -->
            <div class="col-md-9 col-lg-10 p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-2 shadow-sm border-0 border-start border-5 border-success mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                        <span>@TempData["SuccessMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-2 shadow-sm border-0 border-start border-5 border-danger mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                        <span>@TempData["ErrorMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Sticky footer -->
    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container-fluid px-lg-4 text-center text-md-start">
            <span class="text-muted small">&copy; 2026. StudentPartTime Admin Management Console.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>