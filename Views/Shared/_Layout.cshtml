<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="StudentPartTime - Nền tảng kết nối cơ hội việc làm bán thời gian cho sinh viên" />
    <title>@ViewData["Title"] - StudentPartTime</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light-gray">
    <header class="spt-navbar">
        <div class="container">
            <nav class="navbar navbar-expand-md py-0">
                <a class="navbar-brand d-flex align-items-center gap-1 me-4" asp-controller="Home" asp-action="Index">
                    <span class="logo-in-badge fs-5 me-1">in</span>
                    <span class="fw-bold text-dark fs-5">Student<span class="text-linkedin">PT</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 gap-md-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                <span>Trang chủ</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Job" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Job" asp-action="Index">
                                <i class="bi bi-briefcase-fill"></i>
                                <span>Việc làm</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Employer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "MyJobs" ? "active" : "")" asp-controller="Job" asp-action="MyJobs">
                                    <i class="bi bi-clipboard-check-fill"></i>
                                    <span>Tin của tôi</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")" asp-controller="Job" asp-action="Create">
                                    <i class="bi bi-plus-square-fill"></i>
                                    <span>Đăng tuyển</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Student") || User.IsInRole("Employer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Chat" ? "active" : "")" asp-controller="Chat" asp-action="Index">
                                    <i class="bi bi-chat-dots-fill"></i>
                                    <span>Tin nhắn</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Application" ? "active" : "")" asp-controller="Application" asp-action="History">
                                    <i class="bi bi-journal-check"></i>
                                    <span>Ứng tuyển</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Resume" ? "active" : "")" asp-controller="Resume" asp-action="Index">
                                    <i class="bi bi-file-earmark-person-fill"></i>
                                    <span>CV của tôi</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    <span>Quản trị</span>
                                </a>
                                <ul class="dropdown-menu border shadow-sm rounded-3">
                                    <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Users"><i class="bi bi-people-fill me-2 text-linkedin"></i>Quản lý người dùng</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Job" asp-action="PendingJobs"><i class="bi bi-hourglass-split me-2 text-linkedin"></i>Duyệt tin tuyển dụng</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown ms-2">
                                <a class="nav-link dropdown-toggle d-flex flex-column align-items-center border-0 p-0" href="#" role="button" data-bs-toggle="dropdown">
                                    <div class="rounded-circle bg-linkedin text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.9rem;">
                                        @(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="small text-muted mt-1" style="font-size: 0.75rem;">Tôi <i class="bi bi-caret-down-fill"></i></span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border shadow-sm rounded-3 mt-2">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold text-dark">@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</div>
                                        <div class="small text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                                    </li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-fill me-2 text-secondary"></i>Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-shield-key-fill me-2 text-secondary"></i>Đổi mật khẩu</a></li>
                                    <li><hr class="dropdown-divider m-0"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger py-2 w-100 text-start border-0 bg-transparent">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-linkedin me-2" asp-controller="Account" asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-linkedin" asp-controller="Account" asp-action="RegisterStudent">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <div class="container my-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-success bg-white text-dark mb-3" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-4 border-danger bg-white text-dark mb-3" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                    <span>@TempData["ErrorMessage"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
    </div>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Professional Footer -->
    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="logo-in-badge fs-6">in</span>
                    <span class="fw-bold text-dark small">StudentPT</span>
                    <span class="text-muted small">&copy; 2026. Nền tảng tuyển dụng sinh viên chuyên nghiệp.</span>
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted small hover-underline">Bảo mật</a>
                    <a href="#" class="text-decoration-none text-muted small hover-underline">Điều khoản</a>
                    <a href="#" class="text-decoration-none text-muted small hover-underline">Trợ giúp</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
