@model IEnumerable<StudentPartTime.Models.JobType>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý loại công việc";
    ViewData["ActiveTab"] = "JobTypes";
}

<div class="spt-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-briefcase me-2"></i>Quản lý loại công việc</h2>
    <a asp-action="CreateJobType" class="btn btn-spt-primary btn-sm" id="btn-create-jobtype">
        <i class="bi bi-plus-lg me-1"></i>Thêm loại công việc
    </a>
</div>

<div class="spt-card p-3 mb-3">
    <form asp-action="JobTypes" method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên loại công việc..." />
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-search me-1"></i>Tìm kiếm
        </button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
        {
            <a asp-action="JobTypes" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </form>
</div>

<div class="spt-table">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Tên loại công việc</th>
                <th>Mô tả</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Không tìm thấy loại công việc nào.</td>
                </tr>
            }
            @foreach (var jobType in Model)
            {
                <tr>
                    <td class="fw-semibold">@jobType.TypeName</td>
                    <td>@(string.IsNullOrWhiteSpace(jobType.Description) ? "-" : jobType.Description)</td>
                    <td>
                        @if (jobType.IsActive)
                        {
                            <span class="status-pill badge-approved">Hoạt động</span>
                        }
                        else
                        {
                            <span class="status-pill badge-rejected">Vô hiệu hóa</span>
                        }
                    </td>
                    <td>@jobType.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="EditJobType" asp-route-id="@jobType.JobTypeId" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Sửa
                        </a>
                        <form asp-action="ToggleJobTypeStatus" asp-route-id="@jobType.JobTypeId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (jobType.IsActive)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Vô hiệu hóa loại công việc @jobType.TypeName?')">
                                    <i class="bi bi-slash-circle me-1"></i>Vô hiệu hóa
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('Kích hoạt loại công việc @jobType.TypeName?')">
                                    <i class="bi bi-check-circle me-1"></i>Kích hoạt
                                </button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new StudentPartTime.Models.PaginationViewModel
{
    CurrentPage = (int)ViewBag.CurrentPage,
    TotalPages = (int)ViewBag.TotalPages,
    TotalCount = (int)ViewBag.TotalCount,
    Search = (string?)ViewBag.Search,
    Action = "JobTypes"
})
