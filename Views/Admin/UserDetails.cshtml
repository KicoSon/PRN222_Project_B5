@model StudentPartTime.Models.UserDetailViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết người dùng";
    ViewData["ActiveTab"] = "Users";
}

<div class="spt-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-person-lines-fill me-2"></i>Chi tiết người dùng</h2>
    <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
</div>

<div class="spt-card p-4" style="max-width: 720px;">
    <div class="d-flex align-items-center gap-3 mb-4">
        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle" style="width: 64px; height: 64px; object-fit: cover;" />
        }
        else
        {
            <i class="bi bi-person-circle fs-1 text-secondary"></i>
        }
        <div>
            <h4 class="mb-0">@Model.FullName</h4>
            <div class="text-muted">@Model.Email</div>
            <div class="mt-1">
                @foreach (var role in Model.Roles)
                {
                    <span class="badge bg-primary me-1">@role</span>
                }
                @if (Model.IsActive)
                {
                    <span class="status-pill badge-approved">Hoạt động</span>
                }
                else
                {
                    <span class="status-pill badge-rejected">Bị khóa</span>
                }
            </div>
        </div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-4">Số điện thoại</dt>
        <dd class="col-sm-8">@(Model.PhoneNumber ?? "-")</dd>

        <dt class="col-sm-4">Giới tính</dt>
        <dd class="col-sm-8">@(Model.Gender ?? "-")</dd>

        <dt class="col-sm-4">Ngày sinh</dt>
        <dd class="col-sm-8">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")</dd>

        <dt class="col-sm-4">Địa chỉ</dt>
        <dd class="col-sm-8">@(Model.Address ?? "-")</dd>

        <dt class="col-sm-4">Ngày tạo tài khoản</dt>
        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>

        @if (Model.Roles.Contains("Student"))
        {
            <dt class="col-sm-4">Trường</dt>
            <dd class="col-sm-8">@(Model.University ?? "-")</dd>

            <dt class="col-sm-4">Chuyên ngành</dt>
            <dd class="col-sm-8">@(Model.Major ?? "-")</dd>
        }

        @if (Model.Roles.Contains("Employer"))
        {
            <dt class="col-sm-4">Chức vụ</dt>
            <dd class="col-sm-8">@(Model.Position ?? "-")</dd>

            <dt class="col-sm-4">Công ty</dt>
            <dd class="col-sm-8">
                @(Model.CompanyName ?? "-")
                @if (!string.IsNullOrWhiteSpace(Model.CompanyStatus))
                {
                    <span class="badge bg-secondary ms-1">@Model.CompanyStatus</span>
                }
            </dd>
        }
    </dl>

    <hr />

    <form asp-action="LockUnlock" asp-route-userId="@Model.UserId" method="post">
        @Html.AntiForgeryToken()
        @if (Model.IsActive)
        {
            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Khóa tài khoản @Model.Email?')">
                <i class="bi bi-lock me-1"></i>Khóa tài khoản
            </button>
        }
        else
        {
            <button type="submit" class="btn btn-outline-success" onclick="return confirm('Mở khóa tài khoản @Model.Email?')">
                <i class="bi bi-unlock me-1"></i>Mở khóa tài khoản
            </button>
        }
    </form>
</div>
