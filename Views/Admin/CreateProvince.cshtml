@model StudentPartTime.Models.ProvinceViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm tỉnh/thành";
    ViewData["ActiveTab"] = "Provinces";
}

<div class="spt-page-header">
    <h2><i class="bi bi-plus-lg me-2"></i>Thêm tỉnh/thành</h2>
</div>

<div class="spt-card p-4" style="max-width: 640px;">
    <form asp-action="CreateProvince" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-4">
            <label asp-for="ProvinceName" class="form-label fw-semibold">Tên tỉnh/thành</label>
            <input asp-for="ProvinceName" class="form-control" placeholder="Ví dụ: Hà Nội" />
            <span asp-validation-for="ProvinceName" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-spt-primary">
                <i class="bi bi-check-lg me-1"></i>Lưu
            </button>
            <a asp-action="Provinces" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
