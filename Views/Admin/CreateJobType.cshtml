@model StudentPartTime.Models.JobTypeViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm loại công việc";
    ViewData["ActiveTab"] = "JobTypes";
}

<div class="spt-page-header">
    <h2><i class="bi bi-plus-lg me-2"></i>Thêm loại công việc</h2>
</div>

<div class="spt-card p-4" style="max-width: 640px;">
    <form asp-action="CreateJobType" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TypeName" class="form-label fw-semibold">Tên loại công việc</label>
            <input asp-for="TypeName" class="form-control" placeholder="Ví dụ: Bán thời gian" />
            <span asp-validation-for="TypeName" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả ngắn (không bắt buộc)"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-spt-primary">
                <i class="bi bi-check-lg me-1"></i>Lưu
            </button>
            <a asp-action="JobTypes" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
