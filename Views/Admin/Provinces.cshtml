@model IEnumerable<StudentPartTime.Models.Province>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý tỉnh/thành";
    ViewData["ActiveTab"] = "Provinces";
}

<div class="spt-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-geo-alt me-2"></i>Quản lý tỉnh/thành</h2>
    <a asp-action="CreateProvince" class="btn btn-spt-primary btn-sm" id="btn-create-province">
        <i class="bi bi-plus-lg me-1"></i>Thêm tỉnh/thành
    </a>
</div>

<div class="spt-card p-3 mb-3">
    <form asp-action="Provinces" method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên tỉnh/thành..." />
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-search me-1"></i>Tìm kiếm
        </button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search))
        {
            <a asp-action="Provinces" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </form>
</div>

<div class="spt-table">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Tên tỉnh/thành</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">Không tìm thấy tỉnh/thành nào.</td>
                </tr>
            }
            @foreach (var province in Model)
            {
                <tr>
                    <td class="fw-semibold">@province.ProvinceName</td>
                    <td>@province.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="EditProvince" asp-route-id="@province.ProvinceId" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Sửa
                        </a>
                        <form asp-action="DeleteProvince" asp-route-id="@province.ProvinceId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Xóa tỉnh/thành @province.ProvinceName? Hành động này không thể hoàn tác.')">
                                <i class="bi bi-trash me-1"></i>Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new StudentPartTime.Models.PaginationViewModel
{
    CurrentPage = (int)ViewBag.CurrentPage,
    TotalPages = (int)ViewBag.TotalPages,
    TotalCount = (int)ViewBag.TotalCount,
    Search = (string?)ViewBag.Search,
    Action = "Provinces"
})
