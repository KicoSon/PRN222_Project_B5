@model IEnumerable<StudentPartTime.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["ActiveTab"] = "Users";
}

<div class="spt-page-header">
    <h2><i class="bi bi-people me-2"></i>Quản lý người dùng</h2>
</div>

<div class="spt-card p-3 mb-3">
    <form asp-action="Users" method="get" class="row g-2">
        <div class="col-md-6">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên hoặc email..." />
        </div>
        <div class="col-md-4">
            <select name="role" class="form-select">
                <option value="">-- Tất cả vai trò --</option>
                @foreach (var r in (IEnumerable<StudentPartTime.Models.Role>)ViewBag.Roles)
                {
                    <option value="@r.RoleName" selected="@(ViewBag.Role == r.RoleName)">@r.RoleName</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-secondary flex-grow-1">
                <i class="bi bi-search me-1"></i>Tìm
            </button>
            @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search) || !string.IsNullOrWhiteSpace((string?)ViewBag.Role))
            {
                <a asp-action="Users" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<div class="spt-table">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Ngày tạo</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Không tìm thấy người dùng nào.</td>
                </tr>
            }
            @foreach (var user in Model)
            {
                <tr>
                    <td class="fw-semibold">@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="badge bg-primary me-1">@role.RoleName</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="status-pill badge-approved">Hoạt động</span>
                        }
                        else
                        {
                            <span class="status-pill badge-rejected">Bị khóa</span>
                        }
                    </td>
                    <td>
                        <a asp-action="UserDetails" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i>Xem
                        </a>
                        <form asp-action="LockUnlock" asp-route-userId="@user.UserId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (user.IsActive)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger" id="btn-lock-@user.UserId" onclick="return confirm('Khóa tài khoản @user.Email?')">
                                    <i class="bi bi-lock me-1"></i>Khóa
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success" id="btn-unlock-@user.UserId" onclick="return confirm('Mở khóa tài khoản @user.Email?')">
                                    <i class="bi bi-unlock me-1"></i>Mở khóa
                                </button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pagination", new StudentPartTime.Models.PaginationViewModel
{
    CurrentPage = (int)ViewBag.CurrentPage,
    TotalPages = (int)ViewBag.TotalPages,
    TotalCount = (int)ViewBag.TotalCount,
    Search = (string?)ViewBag.Search,
    Action = "Users"
})
