@model StudentPartTime.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="spt-form-card">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock-fill" style="font-size: 3rem; color: var(--spt-secondary)"></i>
                <h2 class="mt-2 fw-bold">Đặt lại mật khẩu</h2>
            </div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" id="input-new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu" id="input-confirm-new-password" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-spt-primary w-100 py-2" id="btn-reset-submit">Đặt lại mật khẩu</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
