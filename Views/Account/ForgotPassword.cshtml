@model StudentPartTime.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="spt-form-card">
            <div class="text-center mb-4">
                <i class="bi bi-key-fill" style="font-size: 3rem; color: var(--spt-accent)"></i>
                <h2 class="mt-2 fw-bold">Quên mật khẩu</h2>
                <p class="text-muted small">Nhập email để tiếp tục quá trình đặt lại mật khẩu</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger py-2 d-none"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="email@example.com" id="input-forgot-email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-spt-primary w-100 py-2" id="btn-forgot-submit">Tiếp tục</button>
                <p class="text-center mt-3">
                    <a asp-action="Login" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
