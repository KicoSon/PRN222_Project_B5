@model StudentPartTime.Models.RegisterStudentViewModel
@{
    ViewData["Title"] = "Đăng ký Sinh viên";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="spt-form-card shadow-sm border">
                <div class="text-center mb-4">
                    <span class="logo-in-badge fs-3 px-2 py-1 me-1">in</span>
                    <span class="fw-bold text-dark fs-4">Student<span class="text-linkedin">PT</span></span>
                    <h1 class="h4 fw-bold text-dark mt-2 mb-1">Đăng ký tài khoản Sinh viên</h1>
                    <p class="text-muted small">Tạo hồ sơ chuyên nghiệp và nộp đơn tìm việc ngay lập tức</p>
                </div>

                <form asp-action="RegisterStudent" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <h6 class="fw-bold text-linkedin mb-3"><i class="bi bi-person-badge me-1"></i>Thông tin cá nhân & Tài khoản</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName">Họ và tên *</label>
                            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" id="input-fullname" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0987654321" id="input-phone" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email">Email đăng nhập *</label>
                            <input asp-for="Email" class="form-control" placeholder="student@example.com" id="input-email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender">Giới tính</label>
                            <select asp-for="Gender" class="form-select" id="select-gender">
                                <option value="">-- Chọn giới tính --</option>
                                <option value="Male">Nam</option>
                                <option value="Female">Nữ</option>
                                <option value="Other">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password">Mật khẩu *</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" id="input-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword">Xác nhận mật khẩu *</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu" id="input-confirm-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-linkedin mb-3"><i class="bi bi-mortarboard me-1"></i>Học vấn & Trường học (Tùy chọn)</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="University">Trường Đại học / Cao đẳng</label>
                            <input asp-for="University" class="form-control" placeholder="VD: Đại học FPT / ĐHQG" id="input-university" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Major">Chuyên ngành học</label>
                            <input asp-for="Major" class="form-control" placeholder="VD: Kỹ thuật phần mềm / Quản trị KD" id="input-major" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GraduationYear">Năm dự kiến tốt nghiệp</label>
                            <input asp-for="GraduationYear" class="form-control" placeholder="2026" type="number" id="input-grad-year" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-linkedin w-100 py-2" id="btn-register">Tham gia ngay</button>
                    <p class="text-center text-muted small mt-3">
                        Đã có tài khoản? <a asp-action="Login" class="fw-bold text-linkedin text-decoration-none hover-underline">Đăng nhập</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
